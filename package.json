{
  "name": "defectresolution",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@sap-ai-sdk/orchestration": "^2.16.0",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "archiver": "^8.0.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.1.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "socks": "^2.8.10",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-defectresolutionui": "cds watch --open defectresolutionui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy defectresolution --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "CRM_GENERIC_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/CRM_GENERIC_SRV",
        "[production]": {
          "credentials": {
            "destination": "Solman_Prod",
            "path": "/sap/opu/odata/salm/CRM_GENERIC_SRV"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "MC_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/MC_SRV",
        "[production]": {
          "credentials": {
            "destination": "Solman_Prod",
            "path": "/sap/opu/odata/salm/MC_SRV"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "DROP_DOC_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/DROP_DOC_SRV",
        "[production]": {
          "credentials": {
            "destination": "Solman_Prod",
            "path": "/sap/opu/odata/salm/MC_SRV"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "ZGW_AI_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/ZGW_AI_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4X_AI",
            "path": "/sap/opu/odata/sap/ZGW_AI_SRV"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}
