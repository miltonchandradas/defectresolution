{
  "name": "defectresolution",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap-ai-sdk/orchestration": "^2.16.0",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "CRM_GENERIC_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/CRM_GENERIC_SRV",
        "[production]": {
          "credentials": {
            "destination": "Solman_Prod",
            "path": "/sap/opu/odata/salm/CRM_GENERIC_SRV"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "MC_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/MC_SRV",
        "[production]": {
          "credentials": {
            "destination": "Solman_Prod",
            "path": "/sap/opu/odata/salm/MC_SRV"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "DROP_DOC_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/DROP_DOC_SRV"
      }
    }
  }
}
